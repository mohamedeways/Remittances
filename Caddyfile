# Caddy gets and renews a free HTTPS certificate automatically for a public domain.
{$DOMAIN} {
    encode gzip
    request_body {
        max_size 20MB
    }
    reverse_proxy app:8000
    header -Server

    # If the server is NOT reachable from the internet and IT provides its own certificate,
    # uncomment the next line (and the ./certs volume in docker-compose.yml):
    # tls /certs/fullchain.pem /certs/privkey.pem
}
